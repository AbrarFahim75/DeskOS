# Python
*.pyc
__pycache__/
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# DeskOS runtime data (lives in ~/.deskos, never in the repo)
.deskos/
*.db

# Diagnostic captures. These are photographs of the user at their desk.
# DeskOS promises that nothing leaves your machine, so a webcam frame must
# never reach a public repository. The diagnostic writes to ~/.deskos by
# design; this pattern is the second line of defence.
diagnose_*.png
*.webcam.png

# Model weights: downloaded automatically by ultralytics on first use.
# Keeping these out of git stops the repo growing by megabytes per model.
*.pt
*.pth
*.onnx

# OS noise
.DS_Store
Thumbs.db