# Normalize line endings so Windows/macOS/Linux contributors never produce
# whole-file whitespace diffs. Without this, every cross-platform commit
# rewrites every line of every file.

# Default: store text as LF in the repo, check out native on Windows.
* text=auto eol=lf

# Windows-only scripts MUST keep CRLF or cmd.exe misbehaves.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts MUST keep LF or they fail with:
#   bad interpreter: /usr/bin/env bash^M
*.sh text eol=lf

# Binaries: never touch these.
*.pt   binary
*.pth  binary
*.onnx binary
*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
*.db   binary
